# ─────────────────────────────────────────────
# SHL Recommender — Environment Configuration
# Copy this file to .env and fill in your keys.
# ─────────────────────────────────────────────

# Which LLM provider to use: google | groq | openai
# Recommendation: use "google" (Gemini 2.0 Flash is free-tier and fast)
LLM_PROVIDER=google

# Google Gemini API key (free at https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq API key (free at https://console.groq.com) — only needed if LLM_PROVIDER=groq
GROQ_API_KEY= your_Groq_api_key_here

# OpenAI API key — only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
